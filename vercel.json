{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://www.googletagmanager.com; script-src-attr 'none'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://vitals.vercel-insights.com; img-src 'self' data: https://*.google-analytics.com https://www.googletagmanager.com; style-src 'self'; font-src 'self'; frame-src 'none'; media-src 'self'; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/assets/main.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/janco-logo-333.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/janco-social-card-arrendamiento.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/favicon-192.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/favicon-maskable.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/apple-touch-icon.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sistemas/arrendamiento-puro",
      "destination": "/sistemas/arrendamiento-puro.html"
    },
    {
      "source": "/recursos/arrendamiento-puro",
      "destination": "/recursos/arrendamiento-puro.html"
    },
    {
      "source": "/recursos/que-es-arrendamiento-puro",
      "destination": "/recursos/que-es-arrendamiento-puro.html"
    },
    {
      "source": "/recursos/sistema-arrendamiento-puro-cobranza-arrendadoras",
      "destination": "/recursos/sistema-arrendamiento-puro-cobranza-arrendadoras.html"
    },
    {
      "source": "/recursos/sistema-arrendamiento-puro",
      "destination": "/recursos/sistema-arrendamiento-puro.html"
    },
    {
      "source": "/recursos/software-cobranza-arrendadoras-mexico",
      "destination": "/recursos/software-cobranza-arrendadoras-mexico.html"
    },
    {
      "source": "/recursos/software-arrendamiento-puro",
      "destination": "/recursos/software-arrendamiento-puro.html"
    },
    {
      "source": "/recursos/software-contratos-arrendamiento-puro",
      "destination": "/recursos/software-contratos-arrendamiento-puro.html"
    },
    {
      "source": "/recursos/consulta-multas-vehiculares-arrendadoras",
      "destination": "/recursos/consulta-multas-vehiculares-arrendadoras.html"
    },
    {
      "source": "/recursos/control-activos-arrendamiento-puro",
      "destination": "/recursos/control-activos-arrendamiento-puro.html"
    },
    {
      "source": "/privacidad",
      "destination": "/privacidad.html"
    }
  ],
  "redirects": [
    {
      "source": "/recursos/software-arrendadoras-financieras.html",
      "destination": "/recursos/software-arrendamiento-puro",
      "permanent": true
    },
    {
      "source": "/recursos/software-arrendadoras-financieras",
      "destination": "/recursos/software-arrendamiento-puro",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.janco.tech"
        }
      ],
      "destination": "https://janco.tech/:path*",
      "permanent": true
    }
  ]
}
